{
  "name": "judgment",
  "version": "0.1.0",
  "private": true,
  "description": "Typed, probabilistic judgment for TypeScript: judgment-core, semantic-types, semantic-sql.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "pnpm -r --sort build",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:live": "LIVE=1 vitest run",
    "test:record": "LIVE=1 JUDGMENT_FIXTURES=record vitest run",
    "showcase": "tsx examples/showcase.ts",
    "clean": "rm -rf packages/*/dist packages/*/*.tsbuildinfo examples/*.tsbuildinfo"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  }
}
