{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "decisions"],
  "properties": {
    "schema_version": {"const": 1},
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim_id", "status", "reason"],
        "properties": {
          "claim_id": {"type": "string", "pattern": "^C[1-9][0-9]*$"},
          "status": {"enum": ["covered", "uncovered", "unclear"]},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
