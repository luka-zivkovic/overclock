{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "evidence_anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "line", "ref", "line_text", "role"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "line": {"type": "integer", "minimum": 1},
        "ref": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "line_text": {"type": "string"},
        "role": {"type": "string", "minLength": 1}
      }
    },
    "changed_anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "line", "ref", "line_text", "role", "side"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "line": {"type": "integer", "minimum": 1},
        "ref": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "line_text": {"type": "string"},
        "role": {"type": "string", "minLength": 1},
        "side": {"enum": ["LEFT", "RIGHT"]}
      }
    },
    "contract_anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "line", "ref", "line_text", "role", "statement"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "line": {"type": "integer", "minimum": 1},
        "ref": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "line_text": {"type": "string"},
        "role": {"type": "string", "minLength": 1},
        "statement": {"type": "string", "minLength": 1}
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "base",
    "head",
    "base_review_sha256",
    "rows",
    "findings",
    "coverage"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "base": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "base_review_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "decision",
          "changed_anchor",
          "contract",
          "producer",
          "consumers",
          "guards_checked",
          "scenario",
          "review_coverage",
          "disposition",
          "root_cause_key",
          "reason"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^C[1-9][0-9]*$"},
          "decision": {"type": "string", "minLength": 1},
          "changed_anchor": {"$ref": "#/$defs/changed_anchor"},
          "contract": {"$ref": "#/$defs/contract_anchor"},
          "producer": {"$ref": "#/$defs/evidence_anchor"},
          "consumers": {
            "type": "array",
            "minItems": 1,
            "items": {"$ref": "#/$defs/evidence_anchor"}
          },
          "guards_checked": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "scenario": {
            "type": "object",
            "additionalProperties": false,
            "required": ["precondition", "action", "observable_failure"],
            "properties": {
              "precondition": {"type": "string", "minLength": 1},
              "action": {"type": "string", "minLength": 1},
              "observable_failure": {"type": "string", "minLength": 1}
            }
          },
          "review_coverage": {
            "type": "object",
            "additionalProperties": false,
            "required": ["status", "reason"],
            "properties": {
              "status": {"enum": ["covered", "uncovered", "unclear"]},
              "reason": {"type": "string", "minLength": 1}
            }
          },
          "disposition": {
            "enum": ["confirmed-gap", "handled", "covered", "unreachable", "unresolved"]
          },
          "root_cause_key": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "row_id",
          "priority",
          "confidence",
          "title",
          "file",
          "line",
          "side",
          "changed_line",
          "failure_path",
          "impact",
          "evidence",
          "suggested_comment"
        ],
        "properties": {
          "row_id": {"type": "string", "pattern": "^C[1-9][0-9]*$"},
          "priority": {"enum": ["P0", "P1", "P2"]},
          "confidence": {"enum": ["high", "medium"]},
          "title": {"type": "string", "minLength": 1},
          "file": {"type": "string", "minLength": 1},
          "line": {"type": "integer", "minimum": 1},
          "side": {"enum": ["LEFT", "RIGHT"]},
          "changed_line": {"type": "string"},
          "failure_path": {"type": "string", "minLength": 1},
          "impact": {"type": "string", "minLength": 1},
          "evidence": {
            "type": "array",
            "minItems": 4,
            "items": {"type": "string", "minLength": 1}
          },
          "suggested_comment": {"type": "string", "minLength": 1}
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "changed_decisions",
        "rows",
        "confirmed_gaps",
        "handled",
        "covered",
        "unreachable",
        "unresolved",
        "inspected_surfaces",
        "blind_spots"
      ],
      "properties": {
        "changed_decisions": {"type": "integer", "minimum": 0},
        "rows": {"type": "integer", "minimum": 0},
        "confirmed_gaps": {"type": "integer", "minimum": 0},
        "handled": {"type": "integer", "minimum": 0},
        "covered": {"type": "integer", "minimum": 0},
        "unreachable": {"type": "integer", "minimum": 0},
        "unresolved": {"type": "integer", "minimum": 0},
        "inspected_surfaces": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "blind_spots": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
