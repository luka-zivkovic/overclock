{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "analysis_base", "risks"],
  "properties": {
    "schema_version": {"const": 1},
    "analysis_base": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "risks": {
      "type": "array",
      "minItems": 0,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "scenario", "impact_signal", "evidence", "probe"],
        "properties": {
          "id": {"type": "string", "pattern": "^R[1-9][0-9]*$"},
          "title": {"type": "string", "minLength": 1},
          "scenario": {"type": "string", "minLength": 1},
          "impact_signal": {"type": "string", "enum": ["low", "medium", "high"]},
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "probe": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
