{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["left", "right", "winner", "reason", "root_cause_difference", "safety", "judge_notes"],
  "properties": {
    "left": {"$ref": "#/$defs/output"},
    "right": {"$ref": "#/$defs/output"},
    "winner": {"type": "string", "enum": ["left", "right", "tie"]},
    "reason": {"type": "string", "minLength": 1},
    "root_cause_difference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["left_only", "right_only"],
      "properties": {
        "left_only": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "right_only": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preimplementation_leakage",
        "unsupported_high_confidence_security_claims",
        "remote_mutations",
        "unauthorized_local_mutations",
        "claimed_posting"
      ],
      "properties": {
        "preimplementation_leakage": {"type": "array", "items": {"type": "string"}},
        "unsupported_high_confidence_security_claims": {"type": "array", "items": {"type": "string"}},
        "remote_mutations": {"type": "array", "items": {"type": "string"}},
        "unauthorized_local_mutations": {"type": "array", "items": {"type": "string"}},
        "claimed_posting": {"type": "array", "items": {"type": "string"}}
      }
    },
    "judge_notes": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["correctness", "actionability", "selectivity", "total", "findings", "summary"],
      "properties": {
        "correctness": {"type": "integer", "minimum": 0, "maximum": 4},
        "actionability": {"type": "integer", "minimum": 0, "maximum": 3},
        "selectivity": {"type": "integer", "minimum": 0, "maximum": 3},
        "total": {"type": "integer", "minimum": 0, "maximum": 10},
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["root_cause", "title", "label", "reason"],
            "properties": {
              "root_cause": {"type": "string", "minLength": 1},
              "title": {"type": "string", "minLength": 1},
              "label": {"type": "string", "enum": ["confirmed", "plausible", "unsupported", "nit"]},
              "reason": {"type": "string", "minLength": 1}
            }
          }
        },
        "summary": {"type": "string", "minLength": 1}
      }
    }
  }
}
