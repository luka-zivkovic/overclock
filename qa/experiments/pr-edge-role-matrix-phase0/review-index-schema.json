{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "base_review_sha256", "actionable_findings", "blind_spots"],
  "properties": {
    "schema_version": {"const": 1},
    "base_review_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "actionable_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["root_cause_key", "title"],
        "properties": {
          "root_cause_key": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,80}$"},
          "title": {"type": "string", "minLength": 1}
        }
      }
    },
    "blind_spots": {"type": "array", "items": {"type": "string", "minLength": 1}}
  }
}
