{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "base_review_sha256",
    "verified_additions",
    "strengthening_notes",
    "rejected_brief_risks"
  ],
  "properties": {
    "base_review_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "verified_additions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "priority",
          "title",
          "location",
          "failure_path",
          "impact",
          "evidence",
          "suggested_comment",
          "brief_origin"
        ],
        "properties": {
          "priority": {"type": "string", "enum": ["P0", "P1", "P2"]},
          "title": {"type": "string", "minLength": 1},
          "location": {"type": "string", "minLength": 1},
          "failure_path": {"type": "string", "minLength": 1},
          "impact": {"type": "string", "minLength": 1},
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "suggested_comment": {"type": "string", "minLength": 1},
          "brief_origin": {"type": "string", "minLength": 1}
        }
      }
    },
    "strengthening_notes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["base_finding", "note", "brief_origin"],
        "properties": {
          "base_finding": {"type": "string", "minLength": 1},
          "note": {"type": "string", "minLength": 1},
          "brief_origin": {"type": "string", "minLength": 1}
        }
      }
    },
    "rejected_brief_risks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["brief_origin", "reason"],
        "properties": {
          "brief_origin": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
