{
  "name": "create-suite",
  "description": "Create a suite from the Test suites screen and see it listed.",
  "url": "http://localhost:5173/suites",
  "viewport": { "width": 1280, "height": 800 },
  "scale": 0.75,
  "fps": 10,
  "max_seconds": 12,
  "end_hold_ms": 1500,
  "settle_ms": 600,
  "mutates": true,
  "storage_state": "../../../.notion-docs-auth/state.json",
  "setup": [
    { "action": "wait", "selector": "role=button[name=\"New suite\"]" }
  ],
  "steps": [
    { "action": "click", "selector": "role=button[name=\"New suite\"]", "caption": "Click New suite" },
    { "action": "type", "selector": "role=textbox[name=\"Name\"]", "text": "Billing regressions", "caption": "Name the suite" },
    { "action": "fill", "selector": "role=textbox[name=\"Slug (kebab-case)\"]", "text": "billing-regressions" },
    { "action": "click", "selector": "role=button[name=\"Create\"]", "caption": "Create" },
    { "action": "wait", "selector": "role=dialog[name=\"New suite\"]", "state": "hidden" },
    { "action": "wait", "selector": "role=link[name=\"Billing regressions\"]" },
    { "action": "caption", "text": "The suite is listed with 0 cases" },
    { "action": "wait", "ms": 800 }
  ]
}
