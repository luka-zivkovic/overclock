{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/skills/lessons-learned/scripts/memory_io.py\" hook --mode lessons",
            "timeout": 10,
            "statusMessage": "Checking .ai/memory/LESSONS.md"
          }
        ]
      }
    ]
  }
}
